{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nexa.local/starbench/campaign-observation-v0.1.schema.json","title":"StarBench Campaign Observation Slot V0.1","type":"object","additionalProperties":false,
  "required":["schema_version","record_type","observation_id","campaign_id","candidate_id","benchmark_task_id","task_version","prompt_id","scenario_id","repeat_index","suite_order","schedule_index","status","run_id","attempt_count","score_status","artifacts","error","source_class","updated_at"],
  "properties":{
    "schema_version":{"const":"0.1"},"record_type":{"const":"CAMPAIGN_OBSERVATION"},"observation_id":{"type":"string","pattern":"^slot_[a-f0-9]{64}$"},"campaign_id":{"type":"string","minLength":1},"candidate_id":{"type":"string","minLength":1},"benchmark_task_id":{"type":"string","minLength":1},"task_version":{"type":"string","minLength":1},"prompt_id":{"type":"string","pattern":"^prompt_[a-f0-9]{64}$"},"scenario_id":{"enum":["planning","coding","instruction_following"]},"repeat_index":{"type":"integer","minimum":1},"suite_order":{"type":"integer","minimum":0},"schedule_index":{"type":"integer","minimum":0},
    "status":{"enum":["PLANNED","RUNNING","SUCCEEDED","FAILED","PARTIAL","SKIPPED","BLOCKED"]},"run_id":{"type":["string","null"],"pattern":"^run_[A-Za-z0-9_-]+$"},"attempt_count":{"type":"integer","minimum":0},"score_status":{"type":["string","null"]},"artifacts":{"type":"object"},"error":{"type":["object","null"]},"source_class":{"const":"TEST_FIXTURE"},"updated_at":{"type":"string","format":"date-time"}
  }
}
