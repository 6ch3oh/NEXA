{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.local/starbench/benchmark-suite-v0.1.schema.json",
  "title": "StarBench Benchmark Suite V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "suite_id", "name", "version", "description",
    "task_references", "default_parameters", "tags", "source_class", "provenance", "metadata", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "record_type": { "const": "BENCHMARK_SUITE" },
    "suite_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" },
    "description": { "type": "string", "minLength": 1 },
    "task_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["benchmark_task_id", "version", "order"],
        "properties": {
          "benchmark_task_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "version": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "default_parameters": { "type": "object" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "source_class": { "enum": ["TEST_FIXTURE", "AUTHORED_DEFINITION"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "source_ref"],
      "properties": {
        "origin": { "enum": ["LOCAL_AUTHORED", "AUTHORIZED_IMPORT"] },
        "source_ref": { "type": ["string", "null"] }
      }
    },
    "metadata": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
