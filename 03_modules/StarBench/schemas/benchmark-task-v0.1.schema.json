{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.local/starbench/benchmark-task-v0.1.schema.json",
  "title": "StarBench Benchmark Task V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "benchmark_task_id", "name", "category", "task_type",
    "description", "prompt", "input_definition", "prompt_identity", "expected_output",
    "evaluation_method", "metrics", "parameters", "tags", "source_class", "provenance",
    "metadata", "created_at", "version"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "record_type": { "const": "BENCHMARK_TASK" },
    "benchmark_task_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "enum": ["planning", "reasoning", "coding", "instruction_following", "long_context", "cost_efficiency", "agent"]
    },
    "task_type": { "enum": ["prompt"] },
    "description": { "type": "string", "minLength": 1 },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "input_template"],
      "properties": {
        "instruction": { "type": "string", "minLength": 1 },
        "input_template": { "type": "string", "minLength": 1 }
      }
    },
    "input_definition": { "type": "object" },
    "prompt_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "prompt_id", "prompt_version"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "prompt_id": { "type": "string", "pattern": "^prompt_[a-f0-9]{64}$" },
        "prompt_version": { "type": "string", "minLength": 1 }
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference", "criteria"],
      "properties": {
        "type": { "enum": ["text", "code", "structured"] },
        "reference": { "type": ["string", "null"] },
        "criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "evaluation_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "config"],
      "properties": {
        "type": { "enum": ["deterministic", "exact_match", "rule_based", "manual", "model_judge_future"] },
        "config": { "type": "object" }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["correctness", "instruction_following", "completion", "latency", "token_usage", "cost"] }
    },
    "parameters": { "type": "object" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "source_class": { "enum": ["TEST_FIXTURE", "AUTHORED_DEFINITION"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "source_ref"],
      "properties": {
        "origin": { "enum": ["LOCAL_AUTHORED", "AUTHORIZED_IMPORT"] },
        "source_ref": { "type": ["string", "null"] }
      }
    },
    "metadata": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" },
    "version": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" }
  }
}
