{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nexa.local/starbench/conditional-replay-v0.1.schema.json","title":"Conditional Replay Comparison V0.1","type":"object","required":["schema_version","record_type","replay_id","decision_id","decision_frozen_before_actual","applicability_status","selected_estimator","evidence_class","actual_total_tokens","production_forecast","shadow_forecast","production_expected_absolute_error","shadow_expected_absolute_error","replay_outcome","truthfulness","metadata"],"properties":{"schema_version":{"const":"0.1"},"record_type":{"const":"CONDITIONAL_REPLAY_COMPARISON"},"replay_id":{"type":"string","pattern":"^conditional_replay_[a-f0-9]{64}$"},"decision_id":{"type":"string"},"decision_frozen_before_actual":{"const":true},"applicability_status":{"type":"string"},"selected_estimator":{"enum":["PRODUCTION","SHADOW_V1"]},"evidence_class":{"type":"string"},"actual_total_tokens":{"type":"integer","minimum":0},"production_forecast":{"type":"object"},"shadow_forecast":{"type":"object"},"production_expected_absolute_error":{"type":"integer","minimum":0},"shadow_expected_absolute_error":{"type":"integer","minimum":0},"replay_outcome":{"enum":["SELECTION_SUPPORTED","CONSERVATIVE_PRODUCTION_TRADEOFF","SELECTION_NOT_SUPPORTED"]},"truthfulness":{"type":"object"},"metadata":{"type":"object"}}}
