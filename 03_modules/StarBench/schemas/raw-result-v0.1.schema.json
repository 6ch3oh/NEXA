{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.local/starbench/raw-result-v0.1.schema.json",
  "title": "StarBench RAW_RESULT V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "timestamp",
    "provider",
    "model",
    "benchmark_task",
    "task_identity",
    "prompt_identity",
    "parameters",
    "success",
    "latency_ms",
    "ttft_ms",
    "prompt_tokens",
    "completion_tokens",
    "total_tokens",
    "throughput_tokens_per_second",
    "cost",
    "request_provenance",
    "error",
    "source_class",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "record_type": { "enum": ["RAW_RESULT", "TEST_FIXTURE"] },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "benchmark_task": { "type": "string", "minLength": 1 },
    "task_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "task_version": { "type": ["string", "null"] }
      }
    },
    "prompt_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "prompt_version"],
      "properties": {
        "prompt_id": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": ["string", "null"] }
      }
    },
    "parameters": { "type": "object" },
    "success": { "type": "boolean" },
    "latency_ms": { "type": ["number", "null"], "minimum": 0 },
    "ttft_ms": { "type": ["number", "null"], "minimum": 0 },
    "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "completion_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "throughput_tokens_per_second": { "type": ["number", "null"], "minimum": 0 },
    "cost": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency", "source"],
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "minLength": 1 },
            "source": { "const": "OBSERVED" }
          }
        }
      ]
    },
    "request_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_identity", "adapter_identity", "adapter_version", "endpoint_class", "request_id", "execution_environment"],
      "properties": {
        "provider_identity": { "type": "string", "minLength": 1 },
        "adapter_identity": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "endpoint_class": { "type": "string", "minLength": 1 },
        "request_id": { "type": ["string", "null"] },
        "execution_environment": { "type": "object" }
      }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "safe_message", "status_code", "retryable"],
          "properties": {
            "category": { "type": "string", "minLength": 1 },
            "safe_message": { "type": "string" },
            "status_code": { "type": ["integer", "null"] },
            "retryable": { "type": "boolean" }
          }
        }
      ]
    },
    "source_class": { "enum": ["PROVIDER_EXECUTION", "TEST_FIXTURE"] },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "record_type": { "const": "TEST_FIXTURE" } } },
      "then": { "properties": { "source_class": { "const": "TEST_FIXTURE" } } }
    },
    {
      "if": { "properties": { "record_type": { "const": "RAW_RESULT" } } },
      "then": { "properties": { "source_class": { "const": "PROVIDER_EXECUTION" } } }
    },
    {
      "if": { "properties": { "success": { "const": true } } },
      "then": { "properties": { "error": { "type": "null" } } }
    }
  ]
}
