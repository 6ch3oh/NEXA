{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nexa.local/starbench/campaign-definition-v0.1.schema.json","title":"StarBench Campaign Definition V0.1","type":"object","additionalProperties":false,
  "required":["schema_version","record_type","campaign_id","version","suite_id","suite_version","candidate_refs","runs_per_task","scenario_scope","budget_policy_ref","budget_status","stop_policy","retry_policy","campaign_state","source_class","created_at","metadata"],
  "properties":{
    "schema_version":{"const":"0.1"},"record_type":{"const":"CAMPAIGN_DEFINITION"},"campaign_id":{"type":"string","pattern":"^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},"version":{"type":"string","pattern":"^[0-9]+[.][0-9]+[.][0-9]+$"},
    "suite_id":{"type":"string","minLength":1},"suite_version":{"type":"string","pattern":"^[0-9]+[.][0-9]+[.][0-9]+$"},
    "candidate_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["candidate_id","version"],"properties":{"candidate_id":{"type":"string","pattern":"^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},"version":{"type":"string","pattern":"^[0-9]+[.][0-9]+[.][0-9]+$"}}}},
    "runs_per_task":{"type":"integer","minimum":1},"scenario_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["planning","coding","instruction_following"]}},
    "budget_policy_ref":{"type":["string","null"]},"budget_status":{"enum":["NOT_AUTHORIZED_REAL_EXECUTION","AUTHORIZED","COMPLETED"]},
    "stop_policy":{"type":"object","additionalProperties":false,"required":["on_failure","max_failures"],"properties":{"on_failure":{"enum":["CONTINUE","STOP"]},"max_failures":{"type":["integer","null"],"minimum":1}}},
    "retry_policy":{"type":"object","additionalProperties":false,"required":["retry_budget"],"properties":{"retry_budget":{"type":"integer","minimum":0}}},
    "campaign_state":{"enum":["NOT_AUTHORIZED","TEST_ONLY","AUTHORIZED","RUNNING","COMPLETED","STOPPED"]},"source_class":{"enum":["TEST_FIXTURE","AUTHORED_DEFINITION"]},"created_at":{"type":"string","format":"date-time"},"metadata":{"type":"object"}
  }
}
