{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexa-private://driving-theory/ocr-draft/1.0",
  "title": "Private driving theory OCR draft",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourcePdfSha256",
    "sourcePage",
    "sourceQuestionIdentity",
    "sourceQuestionType",
    "canonicalContentType",
    "question",
    "options",
    "sourceAnswerSignal",
    "correctAnswerDraft",
    "explanation",
    "imageRequired",
    "derivedMediaCandidate",
    "ocrConfidence",
    "warningCodes",
    "qaDisposition",
    "sourceClassification",
    "sourceOriginClassification",
    "official",
    "nexaBundlingAllowed",
    "draftOnly",
    "formalImportAllowed"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "sourcePdfSha256": { "const": "3409364b3f56ade44ce8940ade9cc15cccb7035e7eac5cef668c1de3ac83def9" },
    "sourcePage": { "type": "integer", "minimum": 2, "maximum": 501 },
    "sourceQuestionIdentity": { "type": "string" },
    "sourceQuestionType": { "enum": ["MC", "TRUE_FALSE", "UNRESOLVED"] },
    "canonicalContentType": { "const": "multiple_choice" },
    "question": { "type": "string" },
    "options": { "type": "array", "items": { "type": "string" }, "minItems": 0, "maxItems": 4 },
    "sourceAnswerSignal": { "type": ["string", "null"], "pattern": "^[A-D]$" },
    "correctAnswerDraft": { "type": ["string", "null"] },
    "explanation": { "type": "string" },
    "imageRequired": { "type": "boolean" },
    "derivedMediaCandidate": { "type": ["object", "null"] },
    "mediaIdentitySha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "ocrConfidence": { "type": "object" },
    "layoutEvidence": { "type": ["object", "null"] },
    "warningCodes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "qaDisposition": { "enum": ["AUTO_QA_CANDIDATE_PASS", "MANUAL_QA_REQUIRED", "EXTRACTION_BLOCKED"] },
    "qaPriority": { "enum": ["P0", "P1", "P2", null] },
    "sourceClassification": { "const": "USER_PROVIDED" },
    "sourceOriginClassification": { "const": "THIRD_PARTY_SOURCE_UNVERIFIED" },
    "official": { "const": false },
    "nexaBundlingAllowed": { "const": false },
    "draftOnly": { "const": true },
    "formalImportAllowed": { "const": false }
  },
  "additionalProperties": true
}
